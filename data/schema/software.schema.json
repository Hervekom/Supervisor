{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supervisor.local/schema/software.schema.json",
  "title": "Software catalogue entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "purpose",
    "work_types",
    "level",
    "condition",
    "publisher_domain",
    "official_download_url",
    "official_docs_url",
    "os",
    "version_guidance",
    "prerequisites",
    "install",
    "verify",
    "common_problems",
    "manual_review",
    "last_reviewed",
    "sources",
    "ecosystem"
  ],
  "$defs": {
    "os": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 3,
      "maxLength": 600
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 300
    },
    "command": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300,
      "pattern": "^[^\\r\\n]+$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "expected": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "enum": [
        "application",
        "python_package",
        "guidance"
      ]
    },
    "purpose": {
      "$ref": "#/$defs/text"
    },
    "work_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "any",
          "statistics",
          "data_science",
          "machine_learning",
          "deep_learning",
          "computer_vision",
          "nlp",
          "simulation",
          "statistics_r",
          "qualitative"
        ]
      }
    },
    "level": {
      "enum": [
        "required",
        "recommended",
        "conditional"
      ]
    },
    "condition": {
      "enum": [
        null,
        "nvidia_gpu"
      ]
    },
    "publisher_domain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "official_download_url": {
      "$ref": "#/$defs/url"
    },
    "official_docs_url": {
      "$ref": "#/$defs/url"
    },
    "os": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/os"
      }
    },
    "version_guidance": {
      "$ref": "#/$defs/text"
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "install": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/os"
      },
      "additionalProperties": {
        "$ref": "#/$defs/steps"
      }
    },
    "verify": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/os"
      },
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "common_problems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "solution"
        ],
        "properties": {
          "problem": {
            "$ref": "#/$defs/text"
          },
          "solution": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "manual_review": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/url"
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "version_guidance",
            "install",
            "expected",
            "common_problems"
          ],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "version_guidance": {
              "type": "string",
              "minLength": 1
            },
            "install": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "windows": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "macos": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "linux": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "windows": {
                  "type": "string",
                  "minLength": 1
                },
                "macos": {
                  "type": "string",
                  "minLength": 1
                },
                "linux": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "common_problems": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "problem",
                  "solution"
                ],
                "properties": {
                  "problem": {
                    "type": "string",
                    "minLength": 1
                  },
                  "solution": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "verify_manual": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ecosystem": {
      "enum": [
        "python",
        "r",
        "general"
      ]
    },
    "verify_where": {
      "enum": [
        "terminal",
        "r_console"
      ]
    },
    "verify_manual": {
      "$ref": "#/$defs/text"
    }
  }
}
