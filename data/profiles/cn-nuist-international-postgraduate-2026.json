        "abstracts",
        "table_of_contents",
        "lists_of_figures_tables_symbols?",
        "main_body",
        "references",
        "appendices?",
        "index?",
        "research_outputs",
        "acknowledgments"
      ],
      "enforcement": "automatic",
      "severity": "major",
      "status": "confirmed",
      "source": {
        "source_id": "guide",
        "quote": "A degree thesis generally consists of the following eleven parts",
        "section": "§I",
        "page": 2
      },
      "note": "Items ending in ? are optional. The order of the two abstracts is a listed conflict."
